+// Self-host: Hanko (passkeys) is optional. Upstream throws here when the
+// keys are missing, which breaks ALL auth because lib/auth/auth-options.ts
+// imports this module. Return null instead; auth-options skips the passkey
+// provider when hanko is null, and Google / email login keep working.
+const hanko =
+  process.env.HANKO_API_KEY && process.env.NEXT_PUBLIC_HANKO_TENANT_ID
+    ? tenant({
+        apiKey: process.env.HANKO_API_KEY as string,
+        tenantId: process.env.NEXT_PUBLIC_HANKO_TENANT_ID!,
+      })
+    : null;

 export default hanko;

