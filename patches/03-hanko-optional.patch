Patch 03: make Hanko (passkeys) optional instead of breaking all auth.
Applies to: papermark/papermark main @ ed19717e,
files lib/hanko.ts and lib/auth/auth-options.ts

Why: lib/hanko.ts throws at import time when HANKO_API_KEY or
NEXT_PUBLIC_HANKO_TENANT_ID is unset, and lib/auth/auth-options.ts imports
that module, so every /api/auth/* request throws and NO login method works,
not just passkeys. The .env.example comment ("required for signup with
passkey") understates this. With this patch, passkey login is simply not
offered when Hanko is not configured, and Google / email login keep working.
If Hanko keys are set, behaviour is unchanged.
---
diff --git a/lib/hanko.ts b/lib/hanko.ts
--- a/lib/hanko.ts
+++ b/lib/hanko.ts
@@ -1,16 +1,15 @@
 import { tenant } from "@teamhanko/passkeys-next-auth-provider";
 
-if (!process.env.HANKO_API_KEY || !process.env.NEXT_PUBLIC_HANKO_TENANT_ID) {
-  // These need to be set in .env.local
-  // You get them from the Passkey API itself, e.g. when first setting up the server.
-  throw new Error(
-    "Please set HANKO_API_KEY and NEXT_PUBLIC_HANKO_TENANT_ID in your .env.local file.",
-  );
-}
-
-const hanko = tenant({
-  apiKey: process.env.HANKO_API_KEY!,
-  tenantId: process.env.NEXT_PUBLIC_HANKO_TENANT_ID!,
-});
+// Self-host: Hanko (passkeys) is optional. Upstream throws here when the
+// keys are missing, which breaks ALL auth because lib/auth/auth-options.ts
+// imports this module. Return null instead; auth-options skips the passkey
+// provider when hanko is null, and Google / email login keep working.
+const hanko =
+  process.env.HANKO_API_KEY && process.env.NEXT_PUBLIC_HANKO_TENANT_ID
+    ? tenant({
+        apiKey: process.env.HANKO_API_KEY as string,
+        tenantId: process.env.NEXT_PUBLIC_HANKO_TENANT_ID!,
+      })
+    : null;
 
 export default hanko;
diff --git a/lib/auth/auth-options.ts b/lib/auth/auth-options.ts
--- a/lib/auth/auth-options.ts
+++ b/lib/auth/auth-options.ts
@@ -101,14 +101,23 @@ export const authOptions: NextAuthOptions = {
         }
       },
     }),
-    PasskeyProvider({
-      tenant: hanko,
-      async authorize({ userId }) {
-        const user = await prisma.user.findUnique({ where: { id: userId } });
-        if (!user) return null;
-        return user;
-      },
-    }),
+    // Self-host: only register the passkey provider when Hanko is
+    // configured (see lib/hanko.ts). Without this, a missing HANKO_API_KEY
+    // breaks every auth route.
+    ...(hanko
+      ? [
+          PasskeyProvider({
+            tenant: hanko,
+            async authorize({ userId }) {
+              const user = await prisma.user.findUnique({
+                where: { id: userId },
+              });
+              if (!user) return null;
+              return user;
+            },
+          }),
+        ]
+      : []),
     {
       id: "saml",
       name: "BoxyHQ SAML",
