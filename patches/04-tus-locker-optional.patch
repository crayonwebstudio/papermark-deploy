Patch 04: make the tus upload locker optional (no-op without Upstash Redis).
Applies to: papermark/papermark main @ ed19717e,
files lib/redis.ts and lib/files/tus-redis-locker.ts

Why: the tus upload routes (pages/api/file/tus and pages/api/file/tus-viewer)
build a RedisLocker from lockerRedisClient, which is an @upstash/redis REST
client. A local redis:7 container cannot serve Upstash REST calls, and with
no Upstash configured every upload fails at lock acquisition. With this
patch, an unset UPSTASH_REDIS_REST_LOCKER_URL makes the locker a no-op.
That is only safe with a single app replica (the draft runs 1 replica) and
low concurrency, which fits this deployment. If Upstash locker vars ARE set,
behaviour is unchanged and the real locker is used.
---
diff --git a/lib/redis.ts b/lib/redis.ts
--- a/lib/redis.ts
+++ b/lib/redis.ts
@@ -7,7 +7,13 @@ export const redis = new Redis({
   token: process.env.UPSTASH_REDIS_REST_TOKEN as string,
 });
 
-export const lockerRedisClient = new Redis({
-  url: process.env.UPSTASH_REDIS_REST_LOCKER_URL as string,
-  token: process.env.UPSTASH_REDIS_REST_LOCKER_TOKEN as string,
-});
+// Self-host: the tus upload locker only. When the Upstash REST locker env
+// vars are not set (fully self-hosted stack), this is null and RedisLocker
+// no-ops (see lib/files/tus-redis-locker.ts). Only safe with a single app
+// replica.
+export const lockerRedisClient = process.env.UPSTASH_REDIS_REST_LOCKER_URL
+  ? new Redis({
+      url: process.env.UPSTASH_REDIS_REST_LOCKER_URL as string,
+      token: process.env.UPSTASH_REDIS_REST_LOCKER_TOKEN as string,
+    })
+  : null;
diff --git a/lib/files/tus-redis-locker.ts b/lib/files/tus-redis-locker.ts
--- a/lib/files/tus-redis-locker.ts
+++ b/lib/files/tus-redis-locker.ts
@@ -25,14 +25,15 @@ import { Redis } from "@upstash/redis";
 
 interface RedisLockerOptions {
   acquireLockTimeout?: number;
-  redisClient: Redis;
+  // Self-host: null when no Upstash locker is configured; the locker no-ops.
+  redisClient: Redis | null;
 }
 
 export class RedisLocker implements Locker {
   timeout: number;
-  redisClient: Redis;
+  redisClient: Redis | null;
 
   constructor(options: RedisLockerOptions) {
     this.timeout = options.acquireLockTimeout ?? 1000 * 30; // default: 30 seconds
     this.redisClient = options.redisClient;
   }
@@ -60,30 +60,37 @@ class RedisLock implements Lock {
   protected async acquireLock(
     id: string,
     requestRelease: RequestRelease,
     signal: AbortSignal,
   ): Promise<boolean> {
     if (signal.aborted) {
       return false;
     }
 
+    // Self-host: no Upstash locker configured (single replica). Skip
+    // locking entirely instead of failing every upload.
+    const redisClient = this.locker.redisClient;
+    if (!redisClient) {
+      return true;
+    }
+
     const lockKey = `tus-lock-${id}`;
-    const lock = await this.locker.redisClient.set(lockKey, "locked", {
+    const lock = await redisClient.set(lockKey, "locked", {
       nx: true,
       px: this.timeout,
     });
 
     if (lock) {
       // Register a release request flag in Redis
-      await this.locker.redisClient.set(`requestRelease:${lockKey}`, "true", {
+      await redisClient.set(`requestRelease:${lockKey}`, "true", {
         px: this.timeout,
       });
       return true;
     }
 
     // Check if the release was requested
-    const releaseRequestStr: string | null = await this.locker.redisClient.get(
+    const releaseRequestStr: string | null = await redisClient.get(
       `requestRelease:${lockKey}`,
     );
     if (releaseRequestStr === "true") {
       await requestRelease?.();
     }
@@ -105,12 +105,17 @@ class RedisLock implements Lock {
   }
 
   async unlock(): Promise<void> {
+    // Self-host: no locker configured, nothing to release.
+    if (!this.locker.redisClient) {
+      return;
+    }
+
     const lockKey = `tus-lock-${this.id}`;
     const lockExists = await this.locker.redisClient.del(lockKey);
     if (!lockExists) {
       throw new Error("Releasing an unlocked lock!");
     }
 
     // Clean up the request release entry
     await this.locker.redisClient.del(`requestRelease:${lockKey}`);
   }
