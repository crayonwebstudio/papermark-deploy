# Papermark on Coolify - environment template
# Copy these into the Coolify app env vars. Never commit real values.
# Vars marked BUILD must also be set as Coolify build-time variables,
# because NEXT_PUBLIC_* values and the middleware host check are baked
# into the client bundle at build time. Changing a BUILD var needs a rebuild.
# Generate secrets with: openssl rand -hex 32

# --- App URLs (REQUIRED, BUILD) ---
NEXTAUTH_URL=https://paper.woodwolfdigital.com
NEXT_PUBLIC_BASE_URL=https://paper.woodwolfdigital.com
NEXT_PUBLIC_MARKETING_URL=https://paper.woodwolfdigital.com
NEXT_PUBLIC_APP_BASE_HOST=paper.woodwolfdigital.com

# --- Auth ---
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Hanko passkeys (OPTIONAL; without these, patch 03 skips passkey login)
HANKO_API_KEY=
NEXT_PUBLIC_HANKO_TENANT_ID=

# --- Database (REQUIRED) ---
# No PgBouncer in this stack, so all three Prisma URLs use the same direct DSN.
POSTGRES_DB=papermark
POSTGRES_USER=papermark
POSTGRES_PASSWORD=
POSTGRES_PRISMA_URL=postgresql://papermark:<POSTGRES_PASSWORD>@postgres:5432/papermark?schema=public
POSTGRES_PRISMA_URL_NON_POOLING=postgresql://papermark:<POSTGRES_PASSWORD>@postgres:5432/papermark?schema=public
POSTGRES_PRISMA_SHADOW_URL=postgresql://papermark:<POSTGRES_PASSWORD>@postgres:5432/papermark?schema=public

# --- Storage: MinIO S3-compatible (REQUIRED) ---
NEXT_PUBLIC_UPLOAD_TRANSPORT=s3
NEXT_PRIVATE_UPLOAD_BUCKET=papermark
NEXT_PRIVATE_ARCHIVE_BUCKET=papermark-archive
NEXT_PRIVATE_UPLOAD_REGION=us-east-1
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID=
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY=
# Must be the PUBLIC MinIO endpoint; browsers fetch presigned URLs from it.
NEXT_PRIVATE_UPLOAD_ENDPOINT=https://s3.paper.woodwolfdigital.com
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_HOST=
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_DOMAIN=
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_KEY_ID=
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_KEY_CONTENTS=

# --- MinIO server ---
MINIO_ROOT_USER=papermark
MINIO_ROOT_PASSWORD=
MINIO_PUBLIC_HOST=s3.paper.woodwolfdigital.com

# --- App secrets (REQUIRED) ---
NEXT_PRIVATE_DOCUMENT_PASSWORD_KEY=
NEXT_PRIVATE_VERIFICATION_SECRET=
INTERNAL_API_KEY=

# --- Email (DEGRADED WITHOUT: no email login, no invites, no notifications) ---
# Email login also needs UPSTASH_REDIS_REST_URL/TOKEN (login codes live in Redis).
RESEND_API_KEY=

# --- Upstash Redis REST (DEGRADED WITHOUT) ---
# Without the locker vars, patch 04 makes the tus upload locker a no-op
# (safe at 1 replica). Without the main vars, email login codes cannot be stored.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_LOCKER_URL=
UPSTASH_REDIS_REST_LOCKER_TOKEN=

# --- Analytics (DEGRADED WITHOUT: no view durations or stats dashboards) ---
TINYBIRD_TOKEN=
TINYBIRD_BASE_URL=

# --- Background jobs (DEGRADED WITHOUT) ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
TRIGGER_SECRET_KEY=

# --- Billing (DEGRADED WITHOUT: billing pages return 500, core app unaffected) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Vercel integration (DEGRADED WITHOUT: custom link domains cannot be added) ---
PROJECT_ID_VERCEL=
TEAM_ID_VERCEL=
AUTH_BEARER_TOKEN=

# --- Runtime ---
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
